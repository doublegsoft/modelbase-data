package ${namespace}.${java.nameNamespace(app.name)}.infra.document;

import org.junit.Assert;
import org.junit.Before;
import org.junit.Rule;
import org.junit.Test;
import org.junit.rules.TemporaryFolder;

import java.io.ByteArrayInputStream;
import java.io.File;
import java.io.IOException;
import java.io.UncheckedIOException;
import java.net.URL;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.HashSet;
import java.util.Set;
import java.util.zip.ZipEntry;
import java.util.zip.ZipInputStream;

public class DocxZipperTest {

  // 保留在 target 目录下生成，且测试结束后不删除，方便人工双击验证 docx 合法性
  @Rule
  public TemporaryFolder tempFolder = new TemporaryFolder(new File("target")) {
    @Override
    public void create() throws IOException {
      new File("target").mkdirs();
      super.create();
    }

    @Override
    protected void after() {
      // 留空，不执行自动删除
    }
  };

  private Path mockDocxDir;

  @Before
  public void setUp() throws Exception {
    File sourceDir = tempFolder.newFolder("docx_build_workspace");
    mockDocxDir = sourceDir.toPath();

    // 1. 获取 resources 中的 docx/test 骨架资源
    URL resourceUrl = getClass().getClassLoader().getResource("docx/test");
    Assert.assertNotNull("测试资源目录 src/test/resources/docx/test 必须存在", resourceUrl);
    Path templateDir = Paths.get(resourceUrl.toURI());

    // 2. 将 resources/docx/test 目录下的所有文件递归复制到工作区
    try (var stream = Files.walk(templateDir)) {
      stream.forEach(source -> {
        Path destination = mockDocxDir.resolve(templateDir.relativize(source).toString());
        try {
          if (Files.isDirectory(source)) {
            if (!Files.exists(destination)) {
              Files.createDirectories(destination);
            }
          } else {
            Files.copy(source, destination, StandardCopyOption.REPLACE_EXISTING);
          }
        } catch (IOException e) {
          throw new UncheckedIOException(e);
        }
      });
    }

    // 3. 动态补齐核心的 word/document.xml 内容
    Path wordDir = mockDocxDir.resolve("word");
    if (!Files.exists(wordDir)) {
      Files.createDirectories(wordDir);
    }
    String minimalDocumentXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
      + "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">"
      + "<w:body><w:p><w:r><w:t>Hello World Generated By DocxZipper</w:t></w:r></w:p></w:body>"
      + "</w:document>";
    Files.write(wordDir.resolve("document.xml"), minimalDocumentXml.getBytes(StandardCharsets.UTF_8));

    // 4. 注入用于测试排除规则的垃圾文件
    Files.write(mockDocxDir.resolve(".DS_Store"), "junk".getBytes(StandardCharsets.UTF_8));
    Files.write(mockDocxDir.resolve("._dummy"), "junk".getBytes(StandardCharsets.UTF_8));
  }

  @Test
  public void testZipDirToDocx_Success() throws IOException {
    File targetDocxFile = new File(tempFolder.getRoot(), "output.docx");
    Path targetDocxPath = targetDocxFile.toPath();

    // 执行打包
    DocxZipper.zipDirToDocx(mockDocxDir, targetDocxPath);

    // 1. 验证目标文件存在且不为空
    Assert.assertTrue("生成的 docx 文件应该存在", Files.exists(targetDocxPath));
    Assert.assertTrue("生成的 docx 文件大小应大于0", Files.size(targetDocxPath) > 0);
    System.out.println(">>> 真实生成的 Docx 路径: " + targetDocxPath.toAbsolutePath());

    // 2. 解包检验内部 entry 路径与排除逻辑
    Set<String> entryNames = new HashSet<>();
    try (ZipInputStream zis = new ZipInputStream(Files.newInputStream(targetDocxPath))) {
      ZipEntry entry;
      while ((entry = zis.getNextEntry()) != null) {
        entryNames.add(entry.getName());
      }
    }

    // 验证来自 resources/docx/test 的文件存在 (如 [Content_Types].xml 或 _rels/.rels)
    Assert.assertTrue("必须包含 [Content_Types].xml", entryNames.contains("[Content_Types].xml"));
    // 验证动态写入的 document.xml 存在
    Assert.assertTrue("必须包含 word/document.xml", entryNames.contains("word/document.xml"));

    // 验证排除文件生效
    Assert.assertFalse("必须排除 .DS_Store", entryNames.contains(".DS_Store"));
    Assert.assertFalse("必须排除 ._ 开头的隐藏文件", entryNames.contains("._dummy"));
  }

  @Test
  public void testZipDirToBytes_Success() throws IOException {
    byte[] docxBytes = DocxZipper.zipDirToBytes(mockDocxDir);

    Assert.assertNotNull("生成的字节数组不应为 null", docxBytes);
    Assert.assertTrue("生成的字节大小应大于 0", docxBytes.length > 0);

    // 检验返回的字节数组为合法 zip 格式且包含必要文件
    Set<String> entryNames = new HashSet<>();
    try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(docxBytes))) {
      ZipEntry entry;
      while ((entry = zis.getNextEntry()) != null) {
        entryNames.add(entry.getName());
      }
    }

    Assert.assertTrue("byte[] 压缩包中应包含 [Content_Types].xml", entryNames.contains("[Content_Types].xml"));
    Assert.assertTrue("byte[] 压缩包中应包含 word/document.xml", entryNames.contains("word/document.xml"));
  }

  @Test(expected = IllegalArgumentException.class)
  public void testZipDirToDocx_NotDirectory_ThrowsException() throws IOException {
    File singleFile = tempFolder.newFile("single.txt");
    File targetDocx = new File(tempFolder.getRoot(), "err.docx");

    DocxZipper.zipDirToDocx(singleFile.toPath(), targetDocx.toPath());
  }
}